# Step 114.1: Made a copy of application.properties and renamed it to application.properties.example
# for the purpose of abstracting sensitive information like database credentials and Payment Gateway API keys.
# only this commited to Git and the actual application.properties is added to .gitignore to prevent accidental commits of sensitive data.
# for more info read GIT_SECRET_PROTECTION.md

spring.application.name=servercomp
server.port=5454

spring.jpa.hibernate.ddl-auto=update
spring.datasource.url=jdbc:mysql://localhost:3306/ez_trad_db
spring.datasource.username=root
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Stripe Payment Gateway Configuration
# Get your secret key from: https://dashboard.stripe.com/apikeys
# For development: use test key (starts with sk_test_)
# For production: use live key (starts with sk_live_)
# You can use environment variable ${STRIPE_API_KEY} or direct value

stripe.api.key=your_stripe_secret_key_here
